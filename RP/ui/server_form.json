{
  "namespace": "server_form",
  "$schema": "https://kalmemarq.github.io/Bugrock-JSON-UI-Schemas/ui.schema.json",
  "long_form": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "jobtree_long_form": {
          "type": "panel",
          "size": [400, 225],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "(not ((#title_text - '§y§r') = #title_text))", "target_property_name": "#visible" }
          ],
          "controls": [
            {
              "bg": {
                "type": "image",
                "texture": "textures/ui/skilltree/jobtree_window_bg_clean",
                "size": ["100%", "100%"],
                "layer": 1
              }
            },
            {
              "branches_overlay": {
                "type": "image",
                "texture": "textures/ui/skilltree/jobtree_branches_overlay_clean",
                "size": ["100%", "100%"],
                "layer": 2
              }
            },
            {
              "close_button": {
                "type": "button",
                "size": [18, 18],
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "offset": [-6, 6],
                "layer": 50,
                "default_control": "def",
                "hover_control": "hov",
                "pressed_control": "hov",
                "button_mappings": [
                  { "from_button_id": "button.menu_select", "to_button_id": "button.menu_exit", "mapping_type": "pressed" }
                ],
                "controls": [
                  { "def": { "type": "image", "texture": "textures/ui/cancel", "size": ["100%", "100%"] } },
                  { "hov": { "type": "image", "texture": "textures/ui/cancel", "size": ["100%", "100%"], "alpha": 0.6 } }
                ]
              }
            },
            {
              "jobtree_grid": {
                "type": "grid",
                "size": ["100%", "100%"],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "layer": 3,
                "collection_name": "form_buttons",
                "grid_dimensions": [1, 20],
                "maximum_grid_items": 30,
                "controls": [
                  { "item_template@server_form.jobtree_grid_item": {} }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "jobtree_grid_item": {
    "type": "panel",
    "size": [0, 0],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "w0": { "type": "panel", "size": [24,24], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [15, 10], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 0)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_tab": { "$tip_anchor_from": "top_middle", "$tip_anchor_to": "bottom_middle", "$tip_text_anchor": "top_left", "$tip_offset": [0, 2], "$tip_text_offset": [10, 8] } }] } },
      { "w1": { "type": "panel", "size": [24,24], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [45, 10], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 1)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_tab": { "$tip_anchor_from": "top_middle", "$tip_anchor_to": "bottom_middle", "$tip_text_anchor": "top_left", "$tip_offset": [0, 2], "$tip_text_offset": [10, 8] } }] } },
      { "w2": { "type": "panel", "size": [24,24], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [75, 10], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 2)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_tab": { "$tip_anchor_from": "top_middle", "$tip_anchor_to": "bottom_middle", "$tip_text_anchor": "top_left", "$tip_offset": [0, 2], "$tip_text_offset": [10, 8] } }] } },
      { "w3": { "type": "panel", "size": [24,24], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [105, 10], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 3)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_tab": { "$tip_anchor_from": "top_middle", "$tip_anchor_to": "bottom_middle", "$tip_text_anchor": "top_left", "$tip_offset": [0, 2], "$tip_text_offset": [10, 8] } }] } },
      
      { "w4": { "type": "panel", "size": [28,28], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [186, 36], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 4)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_l": { "$tip_anchor_from": "top_middle", "$tip_anchor_to": "bottom_middle", "$tip_text_anchor": "top_left", "$tip_offset": [0, 2], "$tip_text_offset": [10, 8] } }] } },
      
      { "w5": { "type": "panel", "size": [24,24], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [88, 88], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 5)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_m": { "$tip_anchor_from": "top_left", "$tip_anchor_to": "bottom_right", "$tip_text_anchor": "top_left", "$tip_offset": [2, 2], "$tip_text_offset": [10, 8] } }] } },
      { "w6": { "type": "panel", "size": [24,24], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [188, 88], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 6)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_m": { "$tip_anchor_from": "top_middle", "$tip_anchor_to": "bottom_middle", "$tip_text_anchor": "top_left", "$tip_offset": [0, 2], "$tip_text_offset": [10, 8] } }] } },
      { "w7": { "type": "panel", "size": [24,24], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [288, 88], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 7)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_m": { "$tip_anchor_from": "top_right", "$tip_anchor_to": "bottom_left", "$tip_text_anchor": "top_left", "$tip_offset": [-2, 2], "$tip_text_offset": [10, 8] } }] } },
      
      { "w8": { "type": "panel", "size": [20,20], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [55, 140], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 8)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_s": { "$tip_anchor_from": "bottom_left", "$tip_anchor_to": "top_right", "$tip_text_anchor": "bottom_left", "$tip_offset": [2, -2], "$tip_text_offset": [10, -8] } }] } },
      { "w9": { "type": "panel", "size": [20,20], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [125, 140], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 9)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_s": { "$tip_anchor_from": "bottom_left", "$tip_anchor_to": "top_right", "$tip_text_anchor": "bottom_left", "$tip_offset": [2, -2], "$tip_text_offset": [10, -8] } }] } },
      { "w10": { "type": "panel", "size": [20,20], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [155, 140], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 10)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_s": { "$tip_anchor_from": "bottom_left", "$tip_anchor_to": "top_right", "$tip_text_anchor": "bottom_left", "$tip_offset": [2, -2], "$tip_text_offset": [10, -8] } }] } },
      { "w11": { "type": "panel", "size": [20,20], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [225, 140], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 11)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_s": { "$tip_anchor_from": "bottom_right", "$tip_anchor_to": "top_left", "$tip_text_anchor": "bottom_left", "$tip_offset": [-2, -2], "$tip_text_offset": [10, -8] } }] } },
      { "w12": { "type": "panel", "size": [20,20], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [255, 140], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 12)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_s": { "$tip_anchor_from": "bottom_right", "$tip_anchor_to": "top_left", "$tip_text_anchor": "bottom_left", "$tip_offset": [-2, -2], "$tip_text_offset": [10, -8] } }] } },
      { "w13": { "type": "panel", "size": [20,20], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [325, 140], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 13)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_s": { "$tip_anchor_from": "bottom_right", "$tip_anchor_to": "top_left", "$tip_text_anchor": "bottom_left", "$tip_offset": [-2, -2], "$tip_text_offset": [10, -8] } }] } },
      
      { "w14": { "type": "panel", "size": [28,28], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [86, 186], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 14)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_l": { "$tip_anchor_from": "bottom_middle", "$tip_anchor_to": "top_middle", "$tip_text_anchor": "bottom_left", "$tip_offset": [0, -2], "$tip_text_offset": [10, -8] } }] } },
      { "w15": { "type": "panel", "size": [28,28], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [186, 186], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 15)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_l": { "$tip_anchor_from": "bottom_middle", "$tip_anchor_to": "top_middle", "$tip_text_anchor": "bottom_left", "$tip_offset": [0, -2], "$tip_text_offset": [10, -8] } }] } },
      { "w16": { "type": "panel", "size": [28,28], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [286, 186], "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }, { "binding_name": "#collection_index", "binding_name_override": "#idx" }, { "binding_type": "view", "source_property_name": "(#idx = 16)", "target_property_name": "#visible" } ], "controls": [{ "b@server_form.btn_node_l": { "$tip_anchor_from": "bottom_middle", "$tip_anchor_to": "top_middle", "$tip_text_anchor": "bottom_left", "$tip_offset": [0, -2], "$tip_text_offset": [10, -8] } }] } }
    ]
  },
  "jobtree_button_visual": {
    "$bg_texture|default": "textures/ui/skilltree/btn_node_default",
    "$icon_size|default": [18, 18],
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "bg": {
          "type": "image",
          "texture": "$bg_texture",
          "layer": 2,
          "size": ["100%", "100%"]
        }
      },
      {
        "icon": {
          "type": "image",
          "texture": "#form_button_texture",
          "texture_file_system": "#form_button_texture_file_system",
          "size": "$icon_size",
          "layer": 3,
          "anchor_from": "center",
          "anchor_to": "center",
          "bindings": [
            { "binding_type": "collection", "binding_name": "#form_button_texture", "binding_collection_name": "form_buttons" },
            { "binding_type": "collection", "binding_name": "#form_button_texture_file_system", "binding_collection_name": "form_buttons" }
          ]
        }
      }
    ]
  },
  "jobtree_tooltip": {
    "type": "image",
    "texture": "textures/ui/skilltree/jobtree_tooltip_bg",
    "size": ["100%c + 20px", "100%c + 16px"],
    "offset": "$tip_offset",
    "anchor_from": "$tip_anchor_from",
    "anchor_to": "$tip_anchor_to",
    "layer": 100,
    "controls": [
      {
        "tip_text": {
          "type": "label",
          "text": "#text",
          "size": ["default", "default"],
          "anchor_from": "$tip_text_anchor",
          "anchor_to": "$tip_text_anchor",
          "offset": "$tip_text_offset",
          "font_scale_factor": 0.65,
          "color": [0.96, 0.93, 0.88],
          "shadow": true,
          "layer": 2,
          "bindings": [
            { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
            { "binding_name": "#form_button_text", "binding_name_override": "#text", "binding_type": "collection", "binding_collection_name": "form_buttons" }
          ]
        }
      }
    ]
  },
  "jobtree_button_base": {
    "$default_texture|default": "textures/ui/skilltree/btn_node_default",
    "$hover_texture|default": "textures/ui/skilltree/btn_node_hover",
    "$icon_size|default": [14, 14],
    "type": "button",
    "size": ["100%", "100%"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "hover",
    "bindings": [{ "binding_type": "collection_details", "binding_collection_name": "form_buttons" }],
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.form_button_click", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.form_button_click", "mapping_type": "focused" }
    ],
    "controls": [
      { "default@server_form.jobtree_button_visual": { "$bg_texture": "$default_texture", "$icon_size": "$icon_size" } },
      { 
        "hover": { 
          "type": "panel", "size": ["100%", "100%"], 
          "controls": [
            { "visual@server_form.jobtree_button_visual": { "$bg_texture": "$hover_texture", "$icon_size": "$icon_size" } },
            { "tooltip@server_form.jobtree_tooltip": { "$tip_offset": "$tip_offset", "$tip_anchor_from": "$tip_anchor_from", "$tip_anchor_to": "$tip_anchor_to", "$tip_text_anchor": "$tip_text_anchor", "$tip_text_offset": "$tip_text_offset" } }
          ] 
        } 
      }
    ]
  },
  "btn_tab@server_form.jobtree_button_base": { "$icon_size": [16, 16], "$default_texture": "textures/ui/skilltree/btn_tab_default" },
  "btn_node_l@server_form.jobtree_button_base": { "$icon_size": [20, 20] },
  "btn_node_m@server_form.jobtree_button_base": { "$icon_size": [16, 16] },
  "btn_node_s@server_form.jobtree_button_base": { "$icon_size": [14, 14] }
}
