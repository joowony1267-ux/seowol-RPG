{
  "namespace": "server_form",
  "$schema": "https://kalmemarq.github.io/Bugrock-JSON-UI-Schemas/ui.schema.json",
  "long_form": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "jobtree_long_form": {
          "type": "panel",
          "size": [400, 225],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "(not ((#title_text - '§y§r') = #title_text))", "target_property_name": "#visible" }
          ],
          "controls": [
            {
              "bg": {
                "type": "image",
                "texture": "textures/ui/skilltree/jobtree_window_bg_clean",
                "size": ["100%", "100%"],
                "layer": 1
              }
            },
            {
              "branches_overlay": {
                "type": "image",
                "texture": "textures/ui/skilltree/jobtree_branches_overlay_clean",
                "size": ["100%", "100%"],
                "layer": 2
              }
            },
            {
              "close_button": {
                "type": "button",
                "size": [18, 18],
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "offset": [-6, 6],
                "layer": 50,
                "default_control": "def",
                "hover_control": "hov",
                "pressed_control": "hov",
                "button_mappings": [
                  { "from_button_id": "button.menu_select", "to_button_id": "button.menu_exit", "mapping_type": "pressed" }
                ],
                "controls": [
                  { "def": { "type": "image", "texture": "textures/ui/cancel", "size": ["100%", "100%"] } },
                  { "hov": { "type": "image", "texture": "textures/ui/cancel", "size": ["100%", "100%"], "alpha": 0.6 } }
                ]
              }
            },
            {
              "jobtree_grid": {
                "type": "grid",
                "size": ["100%", "100%"],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "layer": 3,
                "collection_name": "form_buttons",
                "grid_dimensions": [1, 20],
                "maximum_grid_items": 30,
                "controls": [
                  { "item_template@server_form.jobtree_grid_item": {} }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "jobtree_grid_item": {
    "type": "panel",
    "size": [0, 0],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "w0@server_form.wrapper": { "$idx": 0, "controls": [{ "b@server_form.btn_tab": { "offset": [15, 10], "$tip_anchor_from": "top_middle", "$tip_anchor_to": "bottom_middle", "$tip_offset": [0, 6] } }] } },
      { "w1@server_form.wrapper": { "$idx": 1, "controls": [{ "b@server_form.btn_tab": { "offset": [45, 10], "$tip_anchor_from": "top_middle", "$tip_anchor_to": "bottom_middle", "$tip_offset": [0, 6] } }] } },
      { "w2@server_form.wrapper": { "$idx": 2, "controls": [{ "b@server_form.btn_tab": { "offset": [75, 10], "$tip_anchor_from": "top_middle", "$tip_anchor_to": "bottom_middle", "$tip_offset": [0, 6] } }] } },
      { "w3@server_form.wrapper": { "$idx": 3, "controls": [{ "b@server_form.btn_tab": { "offset": [105, 10], "$tip_anchor_from": "top_middle", "$tip_anchor_to": "bottom_middle", "$tip_offset": [0, 6] } }] } },
      
      { "w4@server_form.wrapper": { "$idx": 4, "controls": [{ "b@server_form.btn_node_l": { "offset": [186, 36], "$tip_anchor_from": "top_middle", "$tip_anchor_to": "bottom_middle", "$tip_offset": [0, 6] } }] } },
      
      { "w5@server_form.wrapper": { "$idx": 5, "controls": [{ "b@server_form.btn_node_m": { "offset": [88, 88], "$tip_anchor_from": "top_left", "$tip_anchor_to": "bottom_right", "$tip_offset": [6, 6] } }] } },
      { "w6@server_form.wrapper": { "$idx": 6, "controls": [{ "b@server_form.btn_node_m": { "offset": [188, 88], "$tip_anchor_from": "top_middle", "$tip_anchor_to": "bottom_middle", "$tip_offset": [0, 6] } }] } },
      { "w7@server_form.wrapper": { "$idx": 7, "controls": [{ "b@server_form.btn_node_m": { "offset": [288, 88], "$tip_anchor_from": "top_right", "$tip_anchor_to": "bottom_left", "$tip_offset": [-6, 6] } }] } },
      
      { "w8@server_form.wrapper": { "$idx": 8, "controls": [{ "b@server_form.btn_node_s": { "offset": [55, 140], "$tip_anchor_from": "bottom_left", "$tip_anchor_to": "top_right", "$tip_offset": [6, -6] } }] } },
      { "w9@server_form.wrapper": { "$idx": 9, "controls": [{ "b@server_form.btn_node_s": { "offset": [125, 140], "$tip_anchor_from": "bottom_left", "$tip_anchor_to": "top_right", "$tip_offset": [6, -6] } }] } },
      { "w10@server_form.wrapper": { "$idx": 10, "controls": [{ "b@server_form.btn_node_s": { "offset": [155, 140], "$tip_anchor_from": "bottom_left", "$tip_anchor_to": "top_right", "$tip_offset": [6, -6] } }] } },
      { "w11@server_form.wrapper": { "$idx": 11, "controls": [{ "b@server_form.btn_node_s": { "offset": [225, 140], "$tip_anchor_from": "bottom_right", "$tip_anchor_to": "top_left", "$tip_offset": [-6, -6] } }] } },
      { "w12@server_form.wrapper": { "$idx": 12, "controls": [{ "b@server_form.btn_node_s": { "offset": [255, 140], "$tip_anchor_from": "bottom_right", "$tip_anchor_to": "top_left", "$tip_offset": [-6, -6] } }] } },
      { "w13@server_form.wrapper": { "$idx": 13, "controls": [{ "b@server_form.btn_node_s": { "offset": [325, 140], "$tip_anchor_from": "bottom_right", "$tip_anchor_to": "top_left", "$tip_offset": [-6, -6] } }] } },
      
      { "w14@server_form.wrapper": { "$idx": 14, "controls": [{ "b@server_form.btn_node_l": { "offset": [86, 186], "$tip_anchor_from": "bottom_middle", "$tip_anchor_to": "top_middle", "$tip_offset": [0, -6] } }] } },
      { "w15@server_form.wrapper": { "$idx": 15, "controls": [{ "b@server_form.btn_node_l": { "offset": [186, 186], "$tip_anchor_from": "bottom_middle", "$tip_anchor_to": "top_middle", "$tip_offset": [0, -6] } }] } },
      { "w16@server_form.wrapper": { "$idx": 16, "controls": [{ "b@server_form.btn_node_l": { "offset": [286, 186], "$tip_anchor_from": "bottom_middle", "$tip_anchor_to": "top_middle", "$tip_offset": [0, -6] } }] } }
    ]
  },
  "wrapper": {
    "type": "panel",
    "size": ["100%", "100%"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      { "binding_name": "#collection_index", "binding_name_override": "#idx_val" },
      { "binding_type": "view", "source_property_name": "(#idx_val = $idx)", "target_property_name": "#visible" }
    ]
  },
  "jobtree_button_visual": {
    "$bg_texture|default": "textures/ui/skilltree/btn_node_default",
    "$icon_size|default": [18, 18],
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "bg": {
          "type": "image",
          "texture": "$bg_texture",
          "layer": 2,
          "size": ["100%", "100%"]
        }
      },
      {
        "icon": {
          "type": "image",
          "texture": "#texture",
          "texture_file_system": "#texture_file_system",
          "size": "$icon_size",
          "layer": 3,
          "anchor_from": "center",
          "anchor_to": "center",
          "bindings": [
            { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
            { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_name": "#form_button_texture_file_system", "binding_name_override": "#texture_file_system", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_type": "view", "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))", "target_property_name": "#visible" }
          ]
        }
      }
    ]
  },
  "jobtree_tooltip": {
    "type": "image",
    "texture": "textures/ui/skilltree/jobtree_tooltip_bg",
    "size": ["100%c + 20px", "100%c + 12px"],
    "offset": "$tip_offset",
    "anchor_from": "$tip_anchor_from",
    "anchor_to": "$tip_anchor_to",
    "layer": 100,
    "controls": [
      {
        "tip_text": {
          "type": "label",
          "text": "#text",
          "offset": [10, 6],
          "size": ["default", "default"],
          "font_scale_factor": 0.65,
          "color": [0.96, 0.93, 0.88],
          "shadow": true,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
            { "binding_name": "#form_button_text", "binding_name_override": "#text", "binding_type": "collection", "binding_collection_name": "form_buttons" }
          ]
        }
      }
    ]
  },
  "jobtree_button_base": {
    "$default_texture|default": "textures/ui/skilltree/btn_node_default",
    "$hover_texture|default": "textures/ui/skilltree/btn_node_hover",
    "$icon_size|default": [14, 14],
    "$button_size|default": [24, 24],
    "type": "button",
    "size": "$button_size",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "hover",
    "bindings": [{ "binding_type": "collection_details", "binding_collection_name": "form_buttons" }],
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.form_button_click", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.form_button_click", "mapping_type": "focused" }
    ],
    "controls": [
      { "default@server_form.jobtree_button_visual": { "$bg_texture": "$default_texture", "$icon_size": "$icon_size" } },
      { 
        "hover": { 
          "type": "panel", "size": ["100%", "100%"], 
          "controls": [
            { "visual@server_form.jobtree_button_visual": { "$bg_texture": "$hover_texture", "$icon_size": "$icon_size" } },
            { "tooltip@server_form.jobtree_tooltip": { "$tip_offset": "$tip_offset", "$tip_anchor_from": "$tip_anchor_from", "$tip_anchor_to": "$tip_anchor_to" } }
          ] 
        } 
      }
    ]
  },
  "btn_tab@server_form.jobtree_button_base": { "$button_size": [24, 24], "$icon_size": [16, 16], "$default_texture": "textures/ui/skilltree/btn_tab_default" },
  "btn_node_l@server_form.jobtree_button_base": { "$button_size": [28, 28], "$icon_size": [20, 20] },
  "btn_node_m@server_form.jobtree_button_base": { "$button_size": [24, 24], "$icon_size": [16, 16] },
  "btn_node_s@server_form.jobtree_button_base": { "$button_size": [20, 20], "$icon_size": [14, 14] }
}